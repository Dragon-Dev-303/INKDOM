# Copy to .env.local and fill in. Never commit .env.local.
# Without these values the game still runs; the matching features switch off.

# --- Supabase: playtest logs + feedback (server only) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Supabase Auth in the browser (sign-in). Same values as above; publishable keys are safe to expose. ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Wallet (points, payments, cosmetics). SECRET: server only. Dashboard > Project Settings > API keys ---
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public base URL of this site (checkout return links and webhook callback URLs)
SITE_URL=http://localhost:3000

# --- Stripe: cards, Apple Pay, Google Pay, Link, local methods. SECRET. ---
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or Dashboard > Developers > Webhooks in production
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- NOWPayments: crypto. SECRET. ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true
# Credit on 'confirmed' instead of waiting for 'finished'
NOWPAYMENTS_CREDIT_ON_CONFIRMED=false

# --- Online play: the Node game server (server/) ---
# Browser: WebSocket URL of the game server (default ws://<host>:3001/ws)
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:3001/ws
# Game server only:
PORT=3001
# Comma-separated browser origins allowed to connect (empty = any, for development)
ALLOWED_ORIGINS=http://localhost:3000
# Development only: let players without an account join as guests
ALLOW_GUESTS=false
